# Postiz environment for Vymotion — copy to the server as postiz.env (NEVER commit real values).
# Mounted into the postiz container via env_file (see README.md).
# Full reference: https://docs.postiz.com/configuration/reference

# === Required
MAIN_URL=https://postiz.vymotion.org
FRONTEND_URL=https://postiz.vymotion.org
NEXT_PUBLIC_BACKEND_URL=https://postiz.vymotion.org/api
JWT_SECRET=CHANGE_ME_long_random_string
DATABASE_URL=postgresql://postiz-user:CHANGE_ME_db_password@postiz-postgres:5432/postiz-db-local
# Must match the password inside DATABASE_URL — the override file feeds this to the
# postgres container, which otherwise keeps the upstream default and rejects Postiz.
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_USER=postiz-user
POSTGRES_DB=postiz-db-local
REDIS_URL=redis://postiz-redis:6379
BACKEND_INTERNAL_URL=http://localhost:3000
TEMPORAL_ADDRESS=temporal:7233
IS_GENERAL=true
RUN_CRON=true

# Flip to true AFTER creating the Vymotion admin account (step 3 in README).
DISABLE_REGISTRATION=false

# Public-API rate limit (per hour, instance-wide). Raised so the Vymotion Worker never 429s.
API_LIMIT=600

# === Storage — Cloudflare R2 (bucket: vymotion-postiz, public access enabled)
STORAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=d4e482d6a5f1da6b0c9a2261c8389b4a
CLOUDFLARE_ACCESS_KEY=CHANGE_ME_r2_token_key_id
CLOUDFLARE_SECRET_ACCESS_KEY=CHANGE_ME_r2_token_secret
CLOUDFLARE_BUCKETNAME=vymotion-postiz
# Public base URL (r2.dev or custom domain) — social platforms fetch media from here.
CLOUDFLARE_BUCKET_URL=https://CHANGE_ME.r2.dev/
CLOUDFLARE_REGION=auto

# === Social platform apps — v1 quick wins (see README §4)
X_API_KEY=
X_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# Bluesky needs no app. Mastodon uses per-instance OAuth against this default instance:
MASTODON_URL=https://mastodon.social

# === Phase D (Meta / TikTok / YouTube — after app reviews)
#INSTAGRAM_APP_ID=
#INSTAGRAM_APP_SECRET=
#FACEBOOK_APP_ID=
#FACEBOOK_APP_SECRET=
#THREADS_APP_ID=
#THREADS_APP_SECRET=
#TIKTOK_CLIENT_ID=
#TIKTOK_CLIENT_SECRET=
#YOUTUBE_CLIENT_ID=
#YOUTUBE_CLIENT_SECRET=

# === Misc
NX_ADD_PLUGINS=false
FEE_AMOUNT=0.05
